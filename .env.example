POSTGRES_DB=coldsync
POSTGRES_USER=coldsync
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql+psycopg://coldsync:change-me-locally@postgres:5432/coldsync
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=./data/chroma
HISTORICAL_CASE_DATASET_PATH=
SBERT_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
SBERT_BATCH_SIZE=32
SBERT_DEVICE=auto
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1
API_CORS_ORIGINS=http://localhost:3000
EVIDENCE_STORAGE_DIR=./data/evidence
MAX_EVIDENCE_FILE_SIZE_MB=15
DEMO_MODE=true
SERPAPI_API_KEY=
SERPAPI_DEFAULT_ENGINE=google
SERPAPI_DEFAULT_GL=in
SERPAPI_DEFAULT_HL=en
SERPAPI_TIMEOUT_SECONDS=15
SERPAPI_MAX_RESULTS_PER_QUERY=10
SERPAPI_MAX_QUERIES_PER_RUN=6
SERPAPI_MAX_QUERIES_PER_RESEARCH_RUN=6
MAX_SEARCH_QUERY_LENGTH=500
NEXT_PUBLIC_MAX_SEARCH_QUERY_LENGTH=500
AGENT_MAX_ITERATIONS=5
AGENT_MAX_ACTIONS_PER_ITERATION=3
AGENT_MAX_SERPAPI_QUERIES=10
AGENT_MAX_RESULTS=50
AGENT_MAX_HISTORICAL_SEARCHES=5
AGENT_MAX_IMAGE_SEARCHES=5
AGENT_MAX_TOTAL_ACTIONS=20
SERPAPI_MOCK_MODE=false
RESEARCH_RATE_LIMIT_PER_MINUTE=5
GEMINI_API_KEY=

CLIP_MODEL_NAME=openai/clip-vit-base-patch32
CLIP_DEVICE=auto
CLIP_BATCH_SIZE=8
HISTORICAL_IMAGE_STORAGE_DIR=/data/historical_images
