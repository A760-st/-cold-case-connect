FROM node:22-alpine
WORKDIR /app
ARG NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1
ARG NEXT_PUBLIC_MAX_EVIDENCE_FILE_SIZE_MB=15
ARG NEXT_PUBLIC_MAX_SEARCH_QUERY_LENGTH=500
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_MAX_EVIDENCE_FILE_SIZE_MB=$NEXT_PUBLIC_MAX_EVIDENCE_FILE_SIZE_MB
ENV NEXT_PUBLIC_MAX_SEARCH_QUERY_LENGTH=$NEXT_PUBLIC_MAX_SEARCH_QUERY_LENGTH
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build
EXPOSE 3000
CMD ["npm", "run", "start"]
